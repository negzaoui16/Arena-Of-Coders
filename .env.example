# ==============================================
# Arena of Coders — Backend Environment Template
# ==============================================

# Server Configuration
PORT=3000
FRONTEND_URL=http://localhost:3000
TRUST_PROXY=false

# MongoDB / Prisma Database Connection
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster.mongodb.net/arena_of_coders?retryWrites=true&w=majority"

# Authentication & Security
JWT_SECRET=replace_with_a_secure_jwt_secret_key
JWT_EXPIRES_IN=7d

# GitHub Scraper & Agent Token (Optional for higher rate limits)
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_HTTP_TIMEOUT_MS=15000

# LLM Judging & Agents (Groq Llama 3)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama3-70b-8192
GROQ_HTTP_TIMEOUT_MS=30000

# Hugging Face Inference (Anti-Cheat & Audio Biometrics)
HUGGINGFACE_TOKEN=hf_your_huggingface_token_here
HUGGINGFACE_HTTP_TIMEOUT_MS=10000

# Stream.io Real-Time Team Chat
STREAM_API_KEY=your_stream_api_key_here
STREAM_API_SECRET=your_stream_api_secret_here

# Hedera Hashgraph (Arena Coin & NFT Certificate Minting)
HEDERA_ACCOUNT_ID=0.0.123456
HEDERA_PRIVATE_KEY=302e020100300506032b657004220420replace_with_hedera_der_private_key
ARENA_COIN_TOKEN_ID=0.0.654321
ARENA_COIN_DECIMALS=2
HEDERA_MIRROR_BASE_URL=https://testnet.mirrornode.hedera.com

# Pinata IPFS (NFT Certificate Storage)
PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET_API_KEY=your_pinata_secret_api_key_here

# Email Verification (SMTP)
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password

# Admin Webhook (Optional n8n notification automation)
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/arena
